# คัดลอกเป็น .env แล้วแก้ค่า (ไฟล์ .env อยู่ใน .gitignore ห้าม commit)

# key หลักของผู้ดูแล ใช้เรียก API ได้ทุก tenant (ห้ามฝังในหน้าเว็บ widget ใช้ public_key ของ tenant แทน)
APP_API_KEY=เปลี่ยนเป็นค่าสุ่มยาว ๆ
TIMEZONE=Asia/Bangkok

# เลือก LLM: claude หรือ openai (openai = API รูปแบบ OpenAI เช่น Typhoon, Ollama, OpenRouter)
LLM_PROVIDER=openai

# ใช้เมื่อ LLM_PROVIDER=openai
LLM_BASE_URL=https://api.opentyphoon.ai/v1
LLM_API_KEY=ใส่คีย์
LLM_MODEL=typhoon-v2.5-30b-a3b-instruct

# ใช้เมื่อ LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# โดเมนที่เรียก API ได้ (CORS) คั่นด้วยจุลภาค ค่าเริ่มต้น * (สิทธิ์จริงตรวจด้วย key + allowed_origins ของ tenant)
# CORS_ORIGINS=*
# LLM_TIMEOUT=120
# HTTP_TIMEOUT=15
