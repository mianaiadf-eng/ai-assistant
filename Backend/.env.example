# คัดลอกเป็น .env แล้วแก้ค่า (ไฟล์ .env อยู่ใน .gitignore ห้าม commit)

# key หลักของผู้ดูแล ใช้เรียก API ได้ทุก client (ห้ามฝังในหน้าเว็บ widget ใช้ public_key ของ client แทน)
APP_API_KEY=เปลี่ยนเป็นค่าสุ่มยาว ๆ
TIMEZONE=Asia/Bangkok

# LLM หลัก: Typhoon (API รูปแบบ OpenAI)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.opentyphoon.ai/v1
LLM_API_KEY=ใส่คีย์
LLM_MODEL=typhoon-v2.5-30b-a3b-instruct

# ทางเลือก (มีค่าใช้จ่าย): LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# ที่อยู่ระบบของ sub agent ตามที่ติดตั้ง (ไม่ใส่ = ใช้ค่าใน agents/<ชื่อ>/agent.py)
# AGENT_PLANKA_BASE_URL=http://localhost:1337

# auth กลาง: token ที่ผู้ใช้ผูกไว้หมดอายุหลังไม่ได้ใช้กี่วินาที (ค่าเริ่มต้น 8 ชั่วโมง)
# LINK_TTL=28800

# โดเมนที่เรียก API ได้ (CORS) คั่นด้วยจุลภาค ค่าเริ่มต้น * (สิทธิ์จริงตรวจด้วย key + allowed_origins ของ client)
# CORS_ORIGINS=*
# LLM_TIMEOUT=120
# HTTP_TIMEOUT=15
